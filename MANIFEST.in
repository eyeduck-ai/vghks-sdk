include LICENSE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md AGENTS.md
include run_sdk.py run_live_test.py run_tests.py
recursive-include docs *.md
recursive-include examples *.py
recursive-include configs *.example.json
recursive-include tests *.py *.pem *.md
recursive-include tools *.py
global-exclude *.pyc *.har *.zip *.log _live_defaults.json _build_info.json
prune data
prune private
prune output
prune dist
prune build
prune tmp
prune newHAR
